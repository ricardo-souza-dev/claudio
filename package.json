{
  "name": "claudio",
  "productName": "Claudio",
  "version": "1.0.10",
  "private": true,
  "description": "Uma só conversa, memória e caixa de ferramentas para qualquer modelo de IA.",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "site:build": "node scripts/build-site.mjs",
    "site:social": "node scripts/make-site-social.mjs",
    "site:screenshot": "npm run build && node scripts/make-site-screenshot.mjs",
    "site:dev": "vite site --host 127.0.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@google/genai": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.20.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.70.0",
    "node-pty": "^1.1.0",
    "openai": "^7.53.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
